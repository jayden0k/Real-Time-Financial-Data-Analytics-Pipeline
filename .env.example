# --- Market data source ---
WS_URL=wss://stream.binance.com:9443/ws/btcusdt@trade
SYMBOLS=BTCUSDT,ETHUSDT

# --- Kafka ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_RAW=market-data-raw
KAFKA_CONSUMER_GROUP=processing-service

# --- Sliding window / anomaly detection ---
WINDOW_SECONDS=10
ANOMALY_ZSCORE_THRESHOLD=3.0
MIN_SAMPLES_FOR_ANOMALY_CHECK=5

# --- Storage ---
STORAGE_BACKEND=sqlite          # sqlite | timescale
SQLITE_DB_PATH=./data/market_data.db
STORAGE_BATCH_SIZE=50
STORAGE_FLUSH_INTERVAL_SECONDS=2.0

# --- TimescaleDB (only used if STORAGE_BACKEND=timescale) ---
TIMESCALE_DSN=postgresql://postgres:postgres@localhost:5432/market_data

# --- Logging ---
LOG_LEVEL=INFO
ENVIRONMENT=development
